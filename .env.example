# =====================================================================
# LinkedIn Tool & AI CV Tailor - Security Environment Template (.env.example)
# Checklist Point 2: Check my env variables
#
# IMPORTANT:
# 1. Never commit your real '.env' file to Git! (Strictly ignored by .gitignore)
# 2. Copy this file to '.env' and populate your real secrets locally or in Streamlit Secrets.
# =====================================================================

# 1. AI Provider Credentials (Point 1: Hide my API keys)
# Get your free Google AI Studio key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
# Optional OpenAI API Key
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# 2. Encryption Vault Key (Point 12: Encrypt sensitive data at rest)
# Generate a random 32-character string to encrypt settings and local tokens
APP_SECRET_KEY=generate_a_random_32_char_secret_key_here

# 3. Application Authentication Gate (Point 4: Add proper authentication)
# Optional password required to open the app (leave blank if public)
APP_ACCESS_PASSWORD=

# 4. Administrator Protection & 2FA (Points 5, 6, 7: Protect admin routes & 2FA)
# Master password for accessing the Security Center and sensitive settings
APP_ADMIN_PASSWORD=Admin@2026ChangeMe!
# Base32 Secret for Google Authenticator / Microsoft Authenticator (RFC 6238)
# Generate via app or python -c "import security_crypto; print(security_crypto.generate_totp_secret())"
APP_ADMIN_2FA_SECRET=

# 5. Usage Quota & Spending Cap (Point 16: Set a spending cap)
# Maximum allowed AI calls per day across all sessions (defaults to 20 for free tier)
APP_DAILY_AI_QUOTA=20
